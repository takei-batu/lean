attribute [simp] Multiset.cons_swap mem_cons_self
theorem cons_swap_triple (a b c : α) (s : Multiset α) :
  a ::ₘ b ::ₘ c ::ₘ s = c ::ₘ a ::ₘ b ::ₘ s := by simp

theorem cons_swap_forth (a b c d : α) (s : Multiset α) :
  a ::ₘ b ::ₘ c ::ₘ d ::ₘ s = c ::ₘ d ::ₘ a ::ₘ b ::ₘ s := by simp

theorem cons_erase_swap [DecidableEq α] {s : Multiset α} {a b c d : α} (hneq : c ≠ d) :
  a ::ₘ b ::ₘ (c ::ₘ s).erase d = c ::ₘ a ::ₘ b ::ₘ s.erase d := by
  simp only [←cons_swap_triple, cons_inj_right]
  exact erase_cons_tail s hneq

theorem erase_cons_tail_of_mem [DecidableEq α] {a x : α} {s : Multiset α} (h_mem : a ∈ s) :
  (x ::ₘ s).erase a = x ::ₘ s.erase a := by
  nth_rw 1 [← cons_erase h_mem, cons_swap, erase_cons_head]

-- theorem erase_cons_tail_of_mem [DecidableEq α] (h : a ∈ s) :
--   (b ::ₘ s).erase a = b ::ₘ s.erase a := by
--   nth_rw 1 [← cons_erase h_mem, cons_swap, erase_cons_head]

theorem erase_cons_tail_of_mem_double [DecidableEq α] {a x y : α} {s : Multiset α} (h_mem : a ∈ s) :
  (x ::ₘ y ::ₘ s).erase a = x ::ₘ y ::ₘ s.erase a := by
  nth_rw 1 [← cons_erase h_mem, cons_swap_triple, erase_cons_head]

lemma cons_erase_eq_of_exists {Γ Γ' : Multiset Formula} {φ ψ : Formula}
  (h : ∃ cs, Γ = φ ::ₘ cs ∧ Γ' = ψ ::ₘ cs) :
  Γ = φ ::ₘ Γ.erase φ ∧ Γ' = ψ ::ₘ Γ.erase φ := by
  obtain ⟨cs, hcs₀, hcs₁⟩ := h
  -- 1つ目の等式の証明
  have h_mem : φ ∈ Γ := by
    rw [hcs₀]
    simp only[mem_cons_self]
  have h₀ : Γ = φ ::ₘ Γ.erase φ := (Multiset.cons_erase h_mem).symm
  -- 2つ目の等式の証明
  have h₁ : Γ' = ψ ::ₘ Γ.erase φ := by
    have h_cs : Γ.erase φ = cs := by
      rw [hcs₀, erase_cons_head]
    rw [h_cs]
    exact hcs₁
  exact ⟨h₀, h₁⟩

